// Masala Story — data model
//
// Production uses PostgreSQL (Render free tier or any managed Postgres).
// Set DATABASE_URL to the connection string. The Linux binary target is
// required so the Prisma engine generated on Windows still has the right
// binary when Render runs the service on Debian.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every tenant-scoped record carries `organizationId`. Super-admin users
// have a null orgId and can see across all tenants; everyone else's
// queries are filtered to their own organization by middleware.
model Organization {
  id                 String    @id
  name               String
  slug               String    @unique // URL-friendly identifier used in customer links
  logoUrl            String    @default("")
  // Static UPI/payment QR image the restaurant uploads. Shown to customers in
  // the post-order "how would you like to pay" popup so they can scan & pay.
  paymentQrUrl       String    @default("")
  themeColor         String    @default("#ea580c") // chilli orange — overridden per-tenant
  address            String    @default("")
  gstNumber          String    @default("")
  contactPhone       String    @default("")
  contactEmail       String    @default("")
  subscriptionPlan   String    @default("trial") // trial | monthly | yearly | enterprise
  // Billing lifecycle. `subscriptionStatus` drives login/feature gating:
  //   trial | active | past_due | cancelled | expired
  // `trialEndsAt` only set while plan == trial. `currentPeriodEnd` is the
  // next renewal date for paid plans (null for trial/enterprise).
  subscriptionStatus String    @default("trial")
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  monthlyPrice       Int       @default(0) // INR, paid plans only
  cancelAtPeriodEnd  Boolean   @default(false)
  // Per-tenant quota overrides. NULL means "use the plan default" from
  // billing.PLAN_LIMITS. Set by super-admin when a tenant needs more or
  // fewer seats than their plan tier normally allows.
  maxTables          Int?
  maxRooms           Int?
  maxUsers           Int?
  maxDishes          Int?
  // Two layers of channel control:
  //  • *OrderingAllowed (platform/plan): whether the tenant is ALLOWED to offer
  //    a channel. NULL = follow the plan default (see billing.effectiveChannels);
  //    the platform admin can pin true/false per tenant from the super-admin
  //    console. A channel that isn't allowed is hidden from the tenant's own
  //    settings and cannot be enabled or ordered from.
  //  • *OrderingEnabled (tenant preference): whether the restaurant turns an
  //    allowed channel on for customers. Effective availability = allowed && enabled.
  tableOrderingAllowed    Boolean?
  roomOrderingAllowed     Boolean?
  takeawayOrderingAllowed Boolean?
  tableOrderingEnabled    Boolean @default(true)
  roomOrderingEnabled     Boolean @default(false)
  takeawayOrderingEnabled Boolean @default(false)
  // Which payment methods the restaurant offers customers. Toggled by the
  // tenant admin from Settings. `payQrEnabled` only takes effect when a
  // paymentQrUrl is uploaded. `payLaterEnabled` lets a guest send the order to
  // the kitchen now and settle the bill afterwards (stays "pending payment").
  payCashEnabled  Boolean @default(true)
  payUpiEnabled   Boolean @default(true)
  payCardEnabled  Boolean @default(true)
  payQrEnabled    Boolean @default(true)
  payLaterEnabled Boolean @default(false)
  // Operational settings — applied to every order/receipt/dashboard for this
  // tenant. `gstRate` is a percentage (5 = 5%). `businessHours` is a JSON
  // array string of weekly slots e.g. [{ day: "mon", open: "10:00", close: "23:00" }].
  timezone           String    @default("Asia/Kolkata")
  locale             String    @default("en")
  currency           String    @default("INR")
  currencySymbol     String    @default("₹")
  gstRate            Float     @default(5)
  taxLabel           String    @default("GST")
  businessHours      String    @default("[]")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  invoices           Invoice[]
}

// Subscription plans, managed by the platform admin. The app keeps an
// in-memory cache of these (billing.loadPlans) so the rest of the code can read
// plan data synchronously. `id` is the plan key stored on Organization.subscriptionPlan.
model Plan {
  id              String   @id            // plan key, e.g. "trial", "monthly", or a custom slug
  label           String
  monthlyPrice    Int      @default(0)    // charge per cycle, INR
  durationDays    Int?                    // cycle length; null = no expiry (enterprise-style)
  billable        Boolean  @default(false)
  isTrial         Boolean  @default(false) // drives trial-status logic (uses trialEndsAt)
  // Resource limits — null = unlimited.
  maxTables       Int?
  maxRooms        Int?
  maxUsers        Int?
  maxDishes       Int?
  // Default channel entitlements for orgs on this plan (per-tenant overrides win).
  channelTable    Boolean  @default(true)
  channelRoom     Boolean  @default(false)
  channelTakeaway Boolean  @default(false)
  // Public signup presentation.
  contactSales    Boolean  @default(false) // "Contact us" instead of instant checkout
  recommended     Boolean  @default(false)
  selfServe       Boolean  @default(true)  // shown on the public signup page
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Subscription discount coupons created by the platform admin and redeemed by
// new customers at signup.
model Coupon {
  id             String    @id
  code           String    @unique // stored uppercase
  description    String    @default("")
  discountType   String    @default("percent") // "percent" | "flat"
  discountValue  Int       @default(0) // percent (1-100) or flat INR
  appliesToPlans String    @default("") // CSV of plan ids; empty = all plans
  maxRedemptions Int?      // null = unlimited
  redemptions    Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code])
}

// One row per billing cycle. Created when a super-admin extends the
// subscription or marks an off-platform payment as received.
model Invoice {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String       @unique // human-readable e.g. INV-2026-0001
  plan           String       // snapshot of subscriptionPlan at invoice time
  amount         Int          // INR
  currency       String       @default("INR")
  status         String       @default("pending") // pending | paid | void | refunded
  periodStart    DateTime
  periodEnd      DateTime
  dueAt          DateTime
  paidAt         DateTime?
  paymentMethod  String       @default("") // upi | card | bank-transfer | cash | other
  notes          String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([dueAt])
}

model User {
  id             String   @id
  organizationId String?  // null for super_admin platform users
  name           String
  email          String   @unique
  role           String
  passwordHash   String
  permissions    String?
  // Admins can deactivate a staff account without deleting it — a deactivated
  // user keeps their data/history but cannot sign in until reactivated.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model Category {
  id             String @id
  organizationId String?
  name           String
  emoji          String
  order          Int
  dishes         Dish[]

  @@index([organizationId])
}

model Dish {
  id             String   @id
  organizationId String?
  name           String
  description    String   @default("")
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  price          Int
  image          String   @default("")
  isVeg          Boolean  @default(true)
  spice          Int      @default(0)
  available      Boolean  @default(true)
  tag            String?
  trackStock     Boolean  @default(false)
  stock          Int      @default(0)
  lowStockAt     Int      @default(5)
  prepMinutes    Int      @default(0)

  @@index([organizationId])
}

// Tables: we keep a synthetic id so two organizations can each have a "Table 1".
// The (orgId, number) pair is the human key.
model Table {
  id             String @id
  organizationId String?
  number         String
  seats          Int    @default(2)

  @@unique([organizationId, number])
  @@index([organizationId])
}

// Room-service location — the room-ordering parallel to Table. Identified by a
// number only (no seats). Orders placed from a room carry serviceType="room".
model Room {
  id             String @id
  organizationId String?
  number         String

  @@unique([organizationId, number])
  @@index([organizationId])
}

model Order {
  id                String      @id
  organizationId    String?
  // Location the order was placed from. `tableNo` holds the number for both
  // dine-in tables and room-service rooms; `serviceType` disambiguates.
  // For dine-in/room this holds the table or room number. For takeaway there is
  // no physical location, so it holds a short generated pickup token.
  tableNo           String
  serviceType       String      @default("table") // "table" | "room" | "takeaway"
  // Human-facing daily order number. Resets to 1 each day per organization
  // (in the org's local timezone). Nullable for orders created before this
  // feature; the API falls back to a short id slice when absent.
  orderNumber       Int?
  // "Pay Later": the guest chose to settle after the meal. The order skips the
  // pay-first kitchen gate (it cooks immediately) but stays paymentStatus
  // "pending" until the cashier records payment.
  payLater          Boolean     @default(false)
  sessionId         String?
  paymentMethod     String      @default("counter")
  paymentStatus     String      @default("pending")
  paymentPaidAt     DateTime?
  paymentAmountPaid Int?
  // Set when the customer taps "I've paid by QR" in the post-order popup. It's
  // an unverified self-report — the cashier still confirms from the billing
  // desk — but it tells them which tables are waiting on a QR confirmation.
  paymentClaimedAt  DateTime?
  subtotal          Int
  tax               Int
  tip               Int         @default(0)
  discount          Int         @default(0)
  total             Int
  status            String      @default("received")
  queuePosition     Int         @default(1)
  etaMinutes        Int         @default(8)
  loyaltyPhone      String?
  pointsEarned      Int         @default(0)
  pointsRedeemed    Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  rating            Rating?

  @@index([organizationId])
  @@index([loyaltyPhone])
}

// One row per (organization, day) holding the last order number handed out
// that day. Incremented atomically when an order is created so each tenant's
// order numbers run 1, 2, 3 … and reset the next day.
model DailyOrderCounter {
  id             Int      @id @default(autoincrement())
  organizationId String
  dayKey         String   // YYYY-MM-DD in the org's local timezone
  value          Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, dayKey])
}

model OrderItem {
  id           Int    @id @default(autoincrement())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId       String
  name         String
  price        Int
  qty          Int
  instructions String @default("")
}

model Rating {
  id        Int      @id @default(autoincrement())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  food      Int      @default(0)
  service   Int      @default(0)
  overall   Int      @default(0)
  comments  String   @default("")
  createdAt DateTime @default(now())
}

model Expense {
  id             String   @id
  organizationId String?
  category       String
  amount         Int
  note           String   @default("")
  date           DateTime @default(now())
  createdBy      String   @default("")
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model LoyaltyMember {
  id             String   @id
  organizationId String?
  phone          String
  name           String   @default("")
  points         Int      @default(0)
  totalSpent     Int      @default(0)
  visits         Int      @default(0)
  joinedAt       DateTime @default(now())
  lastVisitAt    DateTime @default(now())

  @@unique([organizationId, phone])
  @@index([organizationId])
}

model Setting {
  id             String   @id
  organizationId String?
  key            String
  value          String
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id
  organizationId String?
  actorId        String
  actorName      String
  actorRole      String
  action         String
  entity         String
  entityId       String?
  summary        String   @default("")
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
