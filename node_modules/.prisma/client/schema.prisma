// Masala Story — data model
//
// Local dev uses SQLite (zero setup, file: ./dev.db).
// For production, change `provider` to `postgresql` and set DATABASE_URL
// to a PostgreSQL connection string. Schema is compatible with both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Every tenant-scoped record carries `organizationId`. Super-admin users
// have a null orgId and can see across all tenants; everyone else's
// queries are filtered to their own organization by middleware.
model Organization {
  id                 String    @id
  name               String
  slug               String    @unique // URL-friendly identifier used in customer links
  logoUrl            String    @default("")
  themeColor         String    @default("#ea580c") // chilli orange — overridden per-tenant
  address            String    @default("")
  gstNumber          String    @default("")
  contactPhone       String    @default("")
  contactEmail       String    @default("")
  subscriptionPlan   String    @default("trial") // trial | monthly | yearly | enterprise
  // Billing lifecycle. `subscriptionStatus` drives login/feature gating:
  //   trial | active | past_due | cancelled | expired
  // `trialEndsAt` only set while plan == trial. `currentPeriodEnd` is the
  // next renewal date for paid plans (null for trial/enterprise).
  subscriptionStatus String    @default("trial")
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  monthlyPrice       Int       @default(0) // INR, paid plans only
  cancelAtPeriodEnd  Boolean   @default(false)
  // Per-tenant quota overrides. NULL means "use the plan default" from
  // billing.PLAN_LIMITS. Set by super-admin when a tenant needs more or
  // fewer seats than their plan tier normally allows.
  maxTables          Int?
  maxUsers           Int?
  maxDishes          Int?
  // Operational settings — applied to every order/receipt/dashboard for this
  // tenant. `gstRate` is a percentage (5 = 5%). `businessHours` is a JSON
  // array string of weekly slots e.g. [{ day: "mon", open: "10:00", close: "23:00" }].
  timezone           String    @default("Asia/Kolkata")
  locale             String    @default("en")
  currency           String    @default("INR")
  currencySymbol     String    @default("₹")
  gstRate            Float     @default(5)
  taxLabel           String    @default("GST")
  businessHours      String    @default("[]")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  invoices           Invoice[]
}

// One row per billing cycle. Created when a super-admin extends the
// subscription or marks an off-platform payment as received.
model Invoice {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String       @unique // human-readable e.g. INV-2026-0001
  plan           String // snapshot of subscriptionPlan at invoice time
  amount         Int // INR
  currency       String       @default("INR")
  status         String       @default("pending") // pending | paid | void | refunded
  periodStart    DateTime
  periodEnd      DateTime
  dueAt          DateTime
  paidAt         DateTime?
  paymentMethod  String       @default("") // upi | card | bank-transfer | cash | other
  notes          String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([dueAt])
}

model User {
  id             String   @id
  organizationId String? // null for super_admin platform users
  name           String
  email          String   @unique
  role           String
  passwordHash   String
  permissions    String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model Category {
  id             String  @id
  organizationId String?
  name           String
  emoji          String
  order          Int
  dishes         Dish[]

  @@index([organizationId])
}

model Dish {
  id             String   @id
  organizationId String?
  name           String
  description    String   @default("")
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  price          Int
  image          String   @default("")
  isVeg          Boolean  @default(true)
  spice          Int      @default(0)
  available      Boolean  @default(true)
  tag            String?
  trackStock     Boolean  @default(false)
  stock          Int      @default(0)
  lowStockAt     Int      @default(5)
  prepMinutes    Int      @default(0)

  @@index([organizationId])
}

// Tables: we keep a synthetic id so two organizations can each have a "Table 1".
// The (orgId, number) pair is the human key.
model Table {
  id             String  @id
  organizationId String?
  number         String
  seats          Int     @default(2)

  @@unique([organizationId, number])
  @@index([organizationId])
}

model Order {
  id                String      @id
  organizationId    String?
  tableNo           String
  sessionId         String?
  paymentMethod     String      @default("counter")
  paymentStatus     String      @default("pending")
  paymentPaidAt     DateTime?
  paymentAmountPaid Int?
  subtotal          Int
  tax               Int
  tip               Int         @default(0)
  discount          Int         @default(0)
  total             Int
  status            String      @default("received")
  queuePosition     Int         @default(1)
  etaMinutes        Int         @default(8)
  loyaltyPhone      String?
  pointsEarned      Int         @default(0)
  pointsRedeemed    Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  rating            Rating?

  @@index([organizationId])
  @@index([loyaltyPhone])
}

model OrderItem {
  id           Int    @id @default(autoincrement())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId       String
  name         String
  price        Int
  qty          Int
  instructions String @default("")
}

model Rating {
  id        Int      @id @default(autoincrement())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  food      Int      @default(0)
  service   Int      @default(0)
  overall   Int      @default(0)
  comments  String   @default("")
  createdAt DateTime @default(now())
}

model Expense {
  id             String   @id
  organizationId String?
  category       String
  amount         Int
  note           String   @default("")
  date           DateTime @default(now())
  createdBy      String   @default("")
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model LoyaltyMember {
  id             String   @id
  organizationId String?
  phone          String
  name           String   @default("")
  points         Int      @default(0)
  totalSpent     Int      @default(0)
  visits         Int      @default(0)
  joinedAt       DateTime @default(now())
  lastVisitAt    DateTime @default(now())

  @@unique([organizationId, phone])
  @@index([organizationId])
}

model Setting {
  id             String   @id
  organizationId String?
  key            String
  value          String
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id
  organizationId String?
  actorId        String
  actorName      String
  actorRole      String
  action         String
  entity         String
  entityId       String?
  summary        String   @default("")
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
