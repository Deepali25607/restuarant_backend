# ─────────────────────────────────────────────────────────────────────────
# Production environment for AWS (copy to `.env` on the server, fill in real
# values, and NEVER commit the filled-in file — .env is gitignored).
# ─────────────────────────────────────────────────────────────────────────

# App listens on 3007 (per the deployment scenario). Nginx proxies to it.
PORT=3007

# The app's public base URL, INCLUDING the /OrderNow sub-path. Used to build
# absolute URLs for uploaded images. No trailing slash.
PUBLIC_URL=https://nexussoftlab.com/OrderNow

# Socket.io HTTP route. Must match the Nginx location and the frontend.
SOCKET_PATH=/OrderNow/socket.io

# Lock browser access to your domain (comma-separated for multiple origins).
CORS_ORIGIN=https://nexussoftlab.com

# Postgres. Use your AWS RDS endpoint, or a Postgres running on the same EC2 box.
# Example (RDS): postgresql://USER:PASSWORD@your-db.xxxx.rds.amazonaws.com:5432/masala?schema=public
DATABASE_URL="postgresql://masala:CHANGE_ME@localhost:5432/masala?schema=public"

# Sign JWTs with a long random secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Razorpay LIVE keys (leave blank to keep the manual "mark paid" fallback).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
